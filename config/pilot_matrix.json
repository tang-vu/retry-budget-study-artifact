{
  "matrix_version": "1.0",
  "defaults": {
    "connect_timeout_s": 0.5,
    "read_timeout_s": 0.25,
    "contract": {"max_transport_attempts": 5, "max_wall_s": 3.0},
    "reps": 2
  },
  "policies": {
    "p_none": {
      "desc": "control: no retries anywhere (requests native default)",
      "layers": [
        {"kind": "urllib3", "total": 0}
      ]
    },
    "p_u3": {
      "desc": "single transport layer: urllib3 Retry(total=3, forcelist 503)",
      "layers": [
        {"kind": "urllib3", "total": 3, "status_forcelist": [503],
         "backoff_factor": 0.0, "raise_on_status": true}
      ]
    },
    "p_ten": {
      "desc": "single wrapper layer: tenacity stop_after_attempt(3)",
      "layers": [
        {"kind": "tenacity", "stop_attempts": 3, "wait_kind": "fixed",
         "wait_s": 0.02, "on_exception": true, "on_statuses": [503]},
        {"kind": "urllib3", "total": 0}
      ]
    },
    "p_u3_ten": {
      "desc": "naive composition: tenacity(3) x urllib3(total=3), exceptions path",
      "layers": [
        {"kind": "tenacity", "stop_attempts": 3, "wait_kind": "fixed",
         "wait_s": 0.02, "on_exception": true},
        {"kind": "urllib3", "total": 3, "status_forcelist": [503],
         "backoff_factor": 0.0, "raise_on_status": true}
      ]
    },
    "p_u3_ten_rosf": {
      "desc": "composition via response path: urllib3 raise_on_status=false returns 503; tenacity retries on result",
      "layers": [
        {"kind": "tenacity", "stop_attempts": 3, "wait_kind": "fixed",
         "wait_s": 0.02, "on_statuses": [503]},
        {"kind": "urllib3", "total": 3, "status_forcelist": [503],
         "backoff_factor": 0.0, "raise_on_status": false}
      ]
    },
    "p_repaired": {
      "desc": "analyzer-guided minimal repair: retry at ONE layer (urllib3 total=0, tenacity=3)",
      "layers": [
        {"kind": "tenacity", "stop_attempts": 3, "wait_kind": "fixed",
         "wait_s": 0.02, "on_exception": true, "on_statuses": [503]},
        {"kind": "urllib3", "total": 0}
      ]
    },
    "p_budget": {
      "desc": "existing best-practice shared budget over naive composition",
      "layers": [
        {"kind": "budget", "max_attempts": 5, "deadline_s": 3.0},
        {"kind": "tenacity", "stop_attempts": 3, "wait_kind": "fixed",
         "wait_s": 0.02, "on_exception": true},
        {"kind": "urllib3", "total": 3, "status_forcelist": [503],
         "backoff_factor": 0.0, "raise_on_status": true}
      ]
    },
    "p_delay_only": {
      "desc": "soft deadline without attempt cap: tenacity stop_after_delay(0.3) x urllib3(3)",
      "layers": [
        {"kind": "tenacity", "stop_delay_s": 0.3, "wait_kind": "fixed",
         "wait_s": 0.02, "on_exception": true, "on_statuses": [503]},
        {"kind": "urllib3", "total": 3, "status_forcelist": [503],
         "backoff_factor": 0.0, "raise_on_status": true}
      ]
    },
    "p_deadline": {
      "desc": "hard request-scoped deadline(0.55s)+attempt budget(10) over composition",
      "layers": [
        {"kind": "budget", "max_attempts": 10, "deadline_s": 0.55},
        {"kind": "tenacity", "stop_attempts": 3, "wait_kind": "fixed",
         "wait_s": 0.02, "on_exception": true},
        {"kind": "urllib3", "total": 3, "status_forcelist": [503],
         "backoff_factor": 0.0, "raise_on_status": true}
      ]
    },
    "p_u3_nora": {
      "desc": "urllib3 Retry ignoring Retry-After (respect_retry_after_header=false)",
      "layers": [
        {"kind": "urllib3", "total": 3, "status_forcelist": [503],
         "backoff_factor": 0.0, "raise_on_status": true,
         "respect_retry_after": false}
      ]
    },
    "p_httpx": {
      "desc": "survey: httpx transport retries=2 (connect-phase retries only)",
      "layers": [
        {"kind": "httpx", "retries": 2}
      ]
    }
  },
  "failures": {
    "f_ok": {
      "desc": "always 200 (control)",
      "scenario": {"plan": [{"respond": 200, "effect": "apply"}],
                   "default": {"respond": 200, "effect": "apply"}},
      "outcomes": [{"kind": "success"}]
    },
    "f_status503": {
      "desc": "persistent retriable status 503",
      "scenario": {"plan": [{"respond": 503, "effect": "apply"}],
                   "default": {"respond": 503, "effect": "apply"}},
      "outcomes": [{"kind": "status", "status": 503}]
    },
    "f_flaky2": {
      "desc": "two 503 then 200 (transient)",
      "scenario": {"plan": [{"respond": 503, "effect": "apply"},
                            {"respond": 503, "effect": "apply"}],
                   "default": {"respond": 200, "effect": "apply"}},
      "outcomes": [{"kind": "status", "status": 503},
                   {"kind": "status", "status": 503},
                   {"kind": "success"}]
    },
    "f_retry_after": {
      "desc": "503 with Retry-After:1 twice, then 200",
      "scenario": {"plan": [{"respond": 503, "effect": "apply",
                             "headers": {"Retry-After": "1"}},
                            {"respond": 503, "effect": "apply",
                             "headers": {"Retry-After": "1"}}],
                   "default": {"respond": 200, "effect": "apply"}},
      "outcomes": [{"kind": "status", "status": 503, "retry_after_s": 1.0},
                   {"kind": "status", "status": 503, "retry_after_s": 1.0},
                   {"kind": "success"}]
    },
    "f_delay": {
      "desc": "server holds 0.4s then 200; read timeout 0.25 -> every attempt read-times-out, effect still applied",
      "scenario": {"plan": [{"delay_s": 0.4,
                             "then": {"respond": 200, "effect": "apply"}}],
                   "default": {"delay_s": 0.4,
                               "then": {"respond": 200, "effect": "apply"}}},
      "outcomes": [{"kind": "read_err", "delay_s": 0.4}]
    },
    "f_drop": {
      "desc": "response loss AFTER effect applied (server receives, client sees drop)",
      "scenario": {"plan": [{"drop": true, "effect": "apply"}],
                   "default": {"drop": true, "effect": "apply"}},
      "outcomes": [{"kind": "read_err"}]
    },
    "f_refused": {
      "desc": "connect refusal on dead port (Windows: SYN retransmit -> ~connect_timeout)",
      "scenario_type": "dead_port",
      "outcomes": [{"kind": "conn_err"}]
    }
  },
  "cells": [
    {"id": "cal_u3_503", "policy": "p_u3", "failure": "f_status503", "split": "cal"},
    {"id": "cal_ten_503", "policy": "p_ten", "failure": "f_status503", "split": "cal"},

    {"id": "ev_u3ten_503", "policy": "p_u3_ten", "failure": "f_status503", "split": "eval"},
    {"id": "ev_rosf_503", "policy": "p_u3_ten_rosf", "failure": "f_status503", "split": "eval"},
    {"id": "ev_rep_503", "policy": "p_repaired", "failure": "f_status503", "split": "eval"},
    {"id": "ev_bud_503", "policy": "p_budget", "failure": "f_status503", "split": "eval"},
    {"id": "ev_sdelay_503", "policy": "p_delay_only", "failure": "f_status503", "split": "eval"},
    {"id": "ev_hdline_503", "policy": "p_deadline", "failure": "f_status503", "split": "eval"},

    {"id": "cal_u3_delay", "policy": "p_u3", "failure": "f_delay", "split": "cal",
     "contract": {"max_transport_attempts": 5, "max_wall_s": 3.0, "max_effects": 5}},
    {"id": "ev_u3ten_delay", "policy": "p_u3_ten", "failure": "f_delay", "split": "eval",
     "contract": {"max_transport_attempts": 5, "max_wall_s": 3.0, "max_effects": 5}},
    {"id": "ev_u3ten_delay_post", "policy": "p_u3_ten", "failure": "f_delay", "split": "eval",
     "method": "POST",
     "contract": {"max_transport_attempts": 5, "max_wall_s": 3.0, "max_effects": 1}},
    {"id": "ev_hdline_delay", "policy": "p_deadline", "failure": "f_delay", "split": "eval",
     "contract": {"max_transport_attempts": 5, "max_wall_s": 1.2, "max_effects": 5}},
    {"id": "ev_rep_delay", "policy": "p_repaired", "failure": "f_delay", "split": "eval",
     "contract": {"max_transport_attempts": 5, "max_wall_s": 3.0, "max_effects": 5}},

    {"id": "ev_u3_ra", "policy": "p_u3", "failure": "f_retry_after", "split": "eval"},
    {"id": "ev_u3_nora", "policy": "p_u3_nora", "failure": "f_retry_after", "split": "eval"},
    {"id": "ev_bud_ra", "policy": "p_budget", "failure": "f_retry_after", "split": "eval",
     "overrides": {"budget_deadline_s": 1.5}},
    {"id": "ev_u3ten_ra", "policy": "p_u3_ten", "failure": "f_retry_after", "split": "eval"},

    {"id": "ev_u3_drop", "policy": "p_u3", "failure": "f_drop", "split": "eval",
     "contract": {"max_transport_attempts": 5, "max_wall_s": 3.0, "max_effects": 5}},
    {"id": "ev_u3ten_drop", "policy": "p_u3_ten", "failure": "f_drop", "split": "eval",
     "contract": {"max_transport_attempts": 5, "max_wall_s": 3.0, "max_effects": 5}},
    {"id": "ev_bud_drop", "policy": "p_budget", "failure": "f_drop", "split": "eval",
     "contract": {"max_transport_attempts": 5, "max_wall_s": 3.0, "max_effects": 5}},

    {"id": "ev_u3_refused", "policy": "p_u3", "failure": "f_refused", "split": "eval"},
    {"id": "ev_u3ten_refused", "policy": "p_u3_ten", "failure": "f_refused", "split": "eval"},
    {"id": "ev_bud_refused", "policy": "p_budget", "failure": "f_refused", "split": "eval"},
    {"id": "sv_httpx_refused", "policy": "p_httpx", "failure": "f_refused", "split": "eval"},

    {"id": "ev_u3ten_flaky", "policy": "p_u3_ten", "failure": "f_flaky2", "split": "eval"},
    {"id": "ev_bud_flaky", "policy": "p_budget", "failure": "f_flaky2", "split": "eval"},

    {"id": "ctl_none_ok", "policy": "p_none", "failure": "f_ok", "split": "control", "reps": 1},
    {"id": "ctl_none_503", "policy": "p_none", "failure": "f_status503", "split": "control", "reps": 1},
    {"id": "ctl_none_refused", "policy": "p_none", "failure": "f_refused", "split": "control", "reps": 1},

    {"id": "mut_unknown_pred", "policy": "p_ten", "failure": "f_status503", "split": "mutant",
     "mutant": "unknown_predicate",
     "note": "analyzer must return UNKNOWN, never a guessed bound"},
    {"id": "mut_unknown_kind", "policy": "p_ten", "failure": "f_status503", "split": "mutant",
     "mutant": "unknown_layer_kind",
     "note": "analyzer must return UNKNOWN for unmodelled layer kinds"}
  ]
}
